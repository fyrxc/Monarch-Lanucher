<Application x:Class="MonarchLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MonarchLauncher.App.ViewModels"
             xmlns:pages="clr-namespace:MonarchLauncher.App.Views.Pages">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:ServersViewModel}">
                <pages:ServersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
                <pages:FavoritesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecentViewModel}">
                <pages:RecentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <pages:ModsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <pages:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
