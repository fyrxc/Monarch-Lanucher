<UserControl x:Class="MonarchLauncher.App.Views.Pages.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Servers" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ResultCountText}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" Margin="10,3,0,0" />
                <TextBlock Text="•" Foreground="{DynamicResource Brush.TextMuted}" Margin="9,2,9,0" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Style.SecondaryButton}"
                    MinWidth="82" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Style="{StaticResource Style.SearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       Text="Steam live servers"
                       Style="{StaticResource Text.Metadata}"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#1C2229"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.2*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.75*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SERVER" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="MAP" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PLAYERS" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="PING" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="ADDRESS" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredServers}"
                         SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                         Style="{StaticResource Style.ServerList}"
                         ItemContainerStyle="{StaticResource Style.ServerListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.2*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Map}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding PlayerDisplay}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding PingDisplay}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Address}" Style="{StaticResource Text.Metadata}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="5"
                                        Content="JOIN"
                                        Style="{StaticResource Style.SecondaryButton}"
                                        Padding="9,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
