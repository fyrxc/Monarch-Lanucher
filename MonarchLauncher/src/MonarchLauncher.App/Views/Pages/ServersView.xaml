<UserControl x:Class="MonarchLauncher.App.Views.Pages.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Servers" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ResultCountText}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" Margin="10,3,0,0" />
                <TextBlock Text="•" Foreground="{DynamicResource Brush.TextMuted}" Margin="9,2,9,0" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Style.SecondaryButton}"
                    MinWidth="82" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Style="{StaticResource Style.SearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by server name, map, or address" />
            <TextBlock Grid.Column="2"
                       Text="Public DayZ directory"
                       Style="{StaticResource Text.Metadata}"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="FILTERS" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2"
                              Style="{StaticResource Style.FilterCombo}"
                              ItemsSource="{Binding AvailableMaps}"
                              SelectedItem="{Binding SelectedMap, Mode=TwoWay}" />
                    <TextBox Grid.Column="4"
                             Style="{StaticResource Style.SearchBox}"
                             Padding="8,5"
                             FontSize="12"
                             Text="{Binding MinPlayers, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Minimum players" />
                    <TextBox Grid.Column="6"
                             Style="{StaticResource Style.SearchBox}"
                             Padding="8,5"
                             FontSize="12"
                             Text="{Binding MaxPlayers, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Maximum players" />
                    <TextBox Grid.Column="8"
                             Style="{StaticResource Style.SearchBox}"
                             Padding="8,5"
                             FontSize="12"
                             Text="{Binding MaxPing, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Maximum ping when available" />
                    <Button Grid.Column="10"
                            Content="Clear"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource Style.SecondaryButton}"
                            Padding="10,5" />
                </Grid>

                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="Hide empty"
                              Style="{StaticResource Style.FilterCheckBox}"
                              IsChecked="{Binding HideEmpty}" />
                    <CheckBox Content="Hide full"
                              Style="{StaticResource Style.FilterCheckBox}"
                              IsChecked="{Binding HideFull}" />
                    <CheckBox Content="Modded"
                              Style="{StaticResource Style.FilterCheckBox}"
                              IsThreeState="True"
                              IsChecked="{Binding ModdedFilter}"
                              ToolTip="Checked = modded, unchecked = vanilla, dash = either" />
                    <CheckBox Content="Password"
                              Style="{StaticResource Style.FilterCheckBox}"
                              IsThreeState="True"
                              IsChecked="{Binding PasswordFilter}"
                              ToolTip="Checked = passworded, unchecked = no password, dash = either" />
                    <CheckBox Content="Official"
                              Style="{StaticResource Style.FilterCheckBox}"
                              IsThreeState="True"
                              IsChecked="{Binding OfficialFilter}"
                              ToolTip="Checked = official, unchecked = community, dash = either" />
                    <CheckBox Content="1PP only"
                              Style="{StaticResource Style.FilterCheckBox}"
                              IsThreeState="True"
                              IsChecked="{Binding FirstPersonOnlyFilter}"
                              ToolTip="Checked = first-person only, unchecked = third-person allowed, dash = either" />
                    <TextBlock Text="Min / Max players / Max ping"
                               Style="{StaticResource Text.Metadata}"
                               VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="6"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#1C2229"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.4*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="0.65*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SERVER" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="MAP" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PLAYERS" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="MODS" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="MODE" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="PING" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredServers}"
                         SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                         Style="{StaticResource Style.ServerList}"
                         ItemContainerStyle="{StaticResource Style.ServerListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Address}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.4*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="0.65*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="124" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Map}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding PlayerDisplay}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding ModDisplay}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding PerspectiveDisplay}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding PingDisplay}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="☆"
                                            ToolTip="Add or remove favorite"
                                            Style="{StaticResource Style.SecondaryButton}"
                                            Padding="9,5"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="JOIN"
                                            Style="{StaticResource Style.SecondaryButton}"
                                            Padding="9,5"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
