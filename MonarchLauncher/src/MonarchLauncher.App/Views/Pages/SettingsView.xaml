<UserControl x:Class="MonarchLauncher.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />

        <Border Grid.Row="2" Style="{StaticResource Style.CardBorder}" MaxWidth="720" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Steam" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Detected automatically when joining" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="DayZ" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Steam App 221100" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="Server source" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Steam master + A2S" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Style.CardBorder}" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="UPDATES" Style="{StaticResource Text.SectionLabel}" />
                <TextBlock Text="GitHub Releases" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Release builds can check, download, replace files, and restart the launcher from the sidebar button."
                           Style="{StaticResource Text.Metadata}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
