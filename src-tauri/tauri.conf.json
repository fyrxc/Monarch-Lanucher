{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monarch Launcher",
  "version": "0.4.0",
  "identifier": "com.monarch.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monarch Launcher",
        "width": 1360,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Monarch Launcher",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
