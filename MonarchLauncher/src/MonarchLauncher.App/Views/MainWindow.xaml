<Window x:Class="MonarchLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Monarch Lanucher"
        Width="1360"
        Height="820"
        MinWidth="1040"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                           ResizeBorderThickness="6"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="98" Height="18" ClipToBounds="True" HorizontalAlignment="Left">
                        <Image Source="/Assets/monarch-logo.png" Height="18" Width="102" Margin="-4,0,0,0" Stretch="Uniform" HorizontalAlignment="Left" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Monarch Lanucher"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="11"
                           Margin="12,0,0,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Style.TitleBarButton}" Content="—" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource Style.TitleBarButton}" Content="□" Click="MaximizeRestore_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource Style.CloseTitleBarButton}" Content="×" FontSize="16" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,16,14,10">
                        <Border Width="122" Height="28" ClipToBounds="True" HorizontalAlignment="Left">
                            <Image Source="/Assets/monarch-logo.png" Height="28" Width="128" Margin="-6,0,0,0" HorizontalAlignment="Left" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="DAYZ LAUNCHER" Style="{StaticResource Text.SectionLabel}" Margin="1,8,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="8,4,8,8"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Style="{StaticResource Style.NavList}"
                             ItemContainerStyle="{StaticResource Style.NavListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Glyph}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,11">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MONARCH" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LauncherVersion}" Style="{StaticResource Text.Metadata}" VerticalAlignment="Center" />
                            </Grid>
                            <Button Content="{Binding UpdateButtonText}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource Style.SecondaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,9,0,0" />
                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{StaticResource Text.Metadata}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"
                                       MaxHeight="36" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
