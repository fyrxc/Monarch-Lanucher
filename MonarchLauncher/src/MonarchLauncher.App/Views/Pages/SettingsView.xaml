<UserControl x:Class="MonarchLauncher.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />

        <Border Grid.Row="2"
                Style="{StaticResource Style.CardBorder}"
                Width="620"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="PLAYER" Style="{StaticResource Text.SectionLabel}" />
                <TextBlock Text="DayZ Name"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,9,0,0" />
                <TextBlock Text="Used as your in-game DayZ profile name when you join a server from Monarch."
                           Style="{StaticResource Text.Metadata}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,9" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource Style.SearchBox}"
                             Text="{Binding DayZName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="64" />
                    <Button Grid.Column="2"
                            Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource Style.PrimaryButton}" />
                </Grid>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Text.Metadata}"
                           Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource Style.CardBorder}"
                Width="620"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="UPDATES" Style="{StaticResource Text.SectionLabel}" />
                <TextBlock Text="GitHub Releases"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0" />
                <TextBlock Text="Use Check for Updates in the sidebar to install the latest Monarch release."
                           Style="{StaticResource Text.Metadata}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
